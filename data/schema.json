{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dreamdict.web.app/schema/dream-entry.json",
  "title": "DreamEntry",
  "description": "꿈 해몽 항목 하나. data/entries/<category>.json 은 이 객체의 배열이다.",
  "type": "object",
  "required": ["id", "slug", "keyword", "category", "title", "summary", "verdict", "meaning", "variants", "related", "tags", "searchTerms"],
  "additionalProperties": false,
  "properties": {
    "id":       { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "ASCII 식별자. keywords.json 과 일치해야 함" },
    "slug":     { "type": "string", "minLength": 1, "description": "URL 경로. /dream/<slug>/ (한글 허용, 공백은 하이픈)" },
    "keyword":  { "type": "string", "minLength": 2, "description": "표시용 키워드. 예: 뱀 꿈" },
    "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title":    { "type": "string", "minLength": 10, "maxLength": 60, "description": "SEO title. 예: 뱀 꿈 해몽 — 뱀이 나오는 꿈 의미 총정리" },
    "summary":  { "type": "string", "minLength": 30, "maxLength": 120, "description": "한 줄 요약. meta description 겸용" },
    "verdict":  { "type": "string", "enum": ["good", "bad", "neutral", "mixed"], "description": "길몽/흉몽/중립/상황에 따라 다름" },
    "meaning":  { "type": "string", "minLength": 300, "maxLength": 900, "description": "상세 해석 본문(문단은 \\n\\n 구분)" },
    "variants": {
      "type": "array", "minItems": 3, "maxItems": 8,
      "description": "상황별 변형 해석",
      "items": {
        "type": "object", "required": ["situation", "meaning", "verdict"], "additionalProperties": false,
        "properties": {
          "situation": { "type": "string", "minLength": 3, "maxLength": 40, "description": "예: 뱀에게 물리는 꿈" },
          "meaning":   { "type": "string", "minLength": 60, "maxLength": 300 },
          "verdict":   { "type": "string", "enum": ["good", "bad", "neutral", "mixed"] }
        }
      }
    },
    "related":  { "type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "description": "관련 꿈 id 목록(내부 링크용). 모두 keywords.json 에 존재해야 함" },
    "tags":     { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "enum": ["재물", "건강", "연애", "가족", "직장", "학업", "인간관계", "변화", "경고", "행운", "심리", "태몽"] } },
    "searchTerms": { "type": "array", "minItems": 2, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 2 }, "description": "검색 매칭용 이형 표기. 예: 뱀꿈, 뱀 나오는 꿈, 뱀 해몽" }
  }
}
